DROP DATABASE IF EXISTS vendas;
CREATE DATABASE vendas;
USE vendas;

CREATE TABLE cliente(
	codigo_cliente int not null auto_increment,
    nome_cliente varchar(40),
    endereco varchar(100),
    cidade varchar(50),
    cep char(8),
    uf char(2),
    cpf char(11) UNIQUE,
    PRIMARY KEY(codigo_cliente)
);

CREATE TABLE vendedor(
	codigo_vendedor int not null auto_increment,
    nome_vendedor varchar(40),
    salario_fixo decimal(9,2),
    faixa_comissao char(1),
    status enum("ativo","inativo"),
    PRIMARY KEY(codigo_vendedor)    
);

CREATE TABLE pedido(
	numero_pedido int not null auto_increment,
    prazo_entrega_dias smallint,
    data_pedido date, 
    codigo_cliente int,
    codigo_vendedor int,
    FOREIGN KEY(codigo_cliente) 
		REFERENCES CLIENTE(codigo_cliente),
    FOREIGN KEY(codigo_vendedor) 
		REFERENCES VENDEDOR(codigo_vendedor),
	PRIMARY KEY(numero_pedido)
);

CREATE TABLE produto(
	codigo_produto int not null auto_increment,
    unidade_produto ENUM("kg","un","cx"),
    descricao_produto varchar(40),
    valor_unitario decimal(8,2),
    PRIMARY KEY(codigo_produto)
);
 
CREATE TABLE item_pedido(
	numero_pedido int not null,
    codigo_produto int not null,
    quantidade decimal(6,2),
    PRIMARY KEY(numero_pedido, codigo_produto),
    FOREIGN KEY(numero_pedido) 
		REFERENCES PEDIDO(numero_pedido),
    FOREIGN KEY(codigo_produto) 
		REFERENCES PRODUTO(codigo_produto)
);

