-- CONSULTAS --

use barbosa;

-- todos os produtos de uma categoria --

SELECT nome, preco
FROM produto
WHERE codigo_categoria = 3;

-- dados das vendas junto com os clientes -

SELECT
    c.nome,
    v.data_venda,
    v.valor_total
FROM cliente c
JOIN venda v
    ON c.codigo_cliente = v.codigo_cliente;
    
    -- Calcular o faturamento total das vendas --
    
SELECT SUM(valor_total) AS faturamento_total
FROM venda;

	-- Mostrar quantas vendas cada cliente realizou 

SELECT
    c.nome,
    COUNT(v.codigo_venda) AS quantidade_vendas
FROM cliente c
LEFT JOIN venda v
    ON c.codigo_cliente = v.codigo_cliente
GROUP BY c.codigo_cliente, c.nome;

	-- Consultar os produtos com estoque baixo --
    
SELECT
    p.nome,
    e.quantidade
FROM produto p
INNER JOIN estoque e
    ON p.codigo_produto = e.codigo_produto
WHERE e.quantidade <= 5;

	-- Mostrar o valor médio das vendas 
    
    SELECT AVG(valor_total) AS media_vendas
FROM venda;
